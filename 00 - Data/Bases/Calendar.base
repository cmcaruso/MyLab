filters:
  or:
    - type.containsAny(link("Meetings"), link("Events"))
    - and:
        - type.containsAny(link("Tasks"))
        - or:
            - "!start.isEmpty()"
formulas:
  Name: file.asLink(if(name, name, file.name))
  end: if(end.isEmpty(), start + duration, end)
  duration: if(duration.isEmpty(), end - start, duration)
views:
  - type: calendar
    name: Calendar
    mode: auto
    rows: true
    hideNoted: false
  - type: calendar
    name: Today
    mode: agenda
    date: this.file.name
  - type: cards
    name: Cards
    order:
      - formula.Name
      - type
      - start
      - formula.duration
      - formula.end
    sort:
      - property: start
        direction: DESC
    columnSize:
      formula.Name: 204
      note.start: 176
      formula.end: 161
  - type: table
    name: All
    order:
      - formula.Name
      - start
      - duration
      - formula.end
      - related to
    sort:
      - property: related to
        direction: ASC
      - property: start
        direction: ASC
      - property: name
        direction: ASC
    columnSize:
      formula.Name: 204
      note.start: 176
      formula.end: 161
  - type: cards
    name: Related
    filters:
      and:
        - file.hasLink(this)
    order:
      - formula.Name
      - start
      - duration
      - formula.end
      - related to
    sort:
      - property: start
        direction: DESC
    columnSize:
      formula.Name: 204
      note.start: 176
      formula.end: 161
