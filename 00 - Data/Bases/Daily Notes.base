filters:
  and:
    - type.contains(link("Daily Notes"))
views:
  - type: table
    name: All
    order:
      - file.name
      - file.mtime
    sort:
      - property: file.name
        direction: DESC
    columnSize:
      file.name: 147
  - type: table
    name: Related
    order:
      - file.name
