filters:
  or:
    - type.contains(link("Stories"))
    - file.folder == "00 - Data/Stories"
formulas:
  Name: file.asLink(if(name, name, file.name))
  PriorityPool: if(formula.tasks.filter(value.asFile().properties.status != "Done").isEmpty(), formula.tasks, formula.tasks.filter(value.asFile().properties.status != "Done"))
  priority: if(formula.PriorityPool.filter(value.asFile().properties.priority == "Urgent").length > 0, "Urgent", if(formula.PriorityPool.filter(value.asFile().properties.priority == "High").length > 0, "High", if(formula.PriorityPool.filter(value.asFile().properties.priority == "Medium").length > 0, "Medium", if(formula.PriorityPool.filter(value.asFile().properties.priority == "Low").length > 0, "Low", ""))))
  PriorityRank: if(formula.priority == "Urgent", 0, if(formula.priority == "High", 1, if(formula.priority == "Medium", 2, if(formula.priority == "Low", 3, 4))))
  status: |-
    if(
      formula.Tasks.isEmpty(),
      "Backlog",
      if(
        formula.Tasks.filter(value.asFile().properties.status == "Done").length == formula.Tasks.length,
        "Done",
        if(
          formula.Tasks.filter(value.asFile().properties.status == "Planning").length == formula.Tasks.length,
          "Planning",
          if(
            formula.Tasks.filter(value.asFile().properties.status == "Backlog").length == formula.Tasks.length,
            "Backlog",
            "In Progress"
          )
        )
      )
    )
  tasks: file.backlinks.filter(value.asFile().properties.type.contains("Tasks")).map(value.asFile().asLink(if(value.asFile().properties.name, value.asFile().properties.name, value.asFile().name)))
  SprintOrg: if(sprints.isEmpty(), "Backlog", if(sprints.filter(date(value.asFile().properties.start) <= today() && date(value.asFile().properties.end) >= today()).length > 0, "Current", if(sprints.filter(date(value.asFile().properties.start) > today()).length > 0, "Future", "Past")))
views:
  - type: generic-kanban
    name: Active
    filters:
      and:
        - archive != true
    order:
      - formula.Name
      - formula.priority
      - epics
    titleProperty: formula.Name
    columnProperty: formula.status
    columns:
      - Backlog
      - Planning
      - In Progress
      - Done
    columnColors:
      - "Planning = #00b3ff"
      - "In Progress = #fed401"
      - "Done = #06c650"
    columnColorMode: subtle
    showEmpty: false
    sort:
      - property: formula.PriorityRank
        direction: ASC
  - type: generic-kanban
    name: Current Sprint
    filters:
      and:
        - sprints.filter(date(value.asFile().properties.start) <= today() && date(value.asFile().properties.end) >= today()).length > 0
        - archive != true
    order:
      - formula.Name
      - formula.priority
      - epics
    titleProperty: formula.Name
    columnProperty: formula.status
    columns:
      - Backlog
      - Planning
      - In Progress
      - Done
    columnColors:
      - "Planning = #00b3ff"
      - "In Progress = #fed401"
      - "Done = #06c650"
    columnColorMode: subtle
    showEmpty: false
    quickFilterProperties:
      - note.epics
    sort:
      - property: formula.PriorityRank
        direction: ASC
  - type: generic-kanban
    name: Sprint Organization
    filters:
      and:
        - archive != true
    order:
      - formula.Name
      - formula.priority
      - epics
      - formula.SprintOrg
    titleProperty: formula.Name
    columnProperty: formula.SprintOrg
    columns:
      - Backlog
      - Current
      - Future
      - Past
    columnColors:
      - "Current = #00a832"
      - "Future = #005799"
      - "Past = #990000"
    columnColorMode: subtle
    showEmpty: true
    sort:
      - property: formula.PriorityRank
        direction: ASC
  - type: generic-kanban
    name: Related
    filters:
      or:
        - list(epics).contains(this)
        - list(sprints).contains(this)
    order:
      - formula.Name
      - formula.priority
      - epics
    titleProperty: formula.Name
    columnProperty: formula.status
    columns:
      - Backlog
      - Planning
      - In Progress
      - Done
    columnColors:
      - "Planning = #00b3ff"
      - "In Progress = #fed401"
      - "Done = #06c650"
    columnColorMode: subtle
    showEmpty: false
    sort:
      - property: formula.PriorityRank
        direction: ASC
  - type: table
    name: All
    groupBy:
      property: formula.SprintOrg
      direction: ASC
    order:
      - formula.Name
      - formula.priority
      - formula.status
      - formula.tasks
      - sprints
    sort:
      - property: formula.PriorityRank
        direction: ASC
      - property: formula.status
        direction: ASC
    columnSize:
      formula.Name: 408
      formula.tasks: 609
