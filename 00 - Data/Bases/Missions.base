filters:
  or:
    - type.contains(link("Missions"))
    - file.folder == "00 - Data/Missions"
formulas:
  Name: file.asLink(if(name, name, file.name))
  Responsibilities: file.backlinks.filter(value.asFile().properties.type.contains( "Responsibilities")).map(value.asFile().asLink(if(value.asFile().properties.name, value.asFile().properties.name, value.asFile().name)))
  Projects: file.backlinks.filter(value.asFile().properties.type.contains("Responsibilities")).map(value.asFile().backlinks).flat().filter(value.asFile().properties.type.contains("Projects")).map(value.asFile().asLink(if(value.asFile().properties.name, value.asFile().properties.name, value.asFile().name)))
  Current Projects: formula.Projects.filter(value.asFile().properties.archive != true)
  active: if(!formula["Current Projects"].isEmpty(), "Active Projects", "Not Active Projects")
properties:
  formula.Responsibilities:
    displayName: responsibilities
  formula.Current Projects:
    displayName: active projects
  formula.Projects:
    displayName: projects
views:
  - type: generic-kanban
    titleProperty: formula.Name
    name: Active
    order:
      - formula.Name
      - formula.Responsibilities
      - formula.Current Projects
    columnProperty: formula.active
    columns:
      - Not Active Projects
      - Active Projects
    columnColors: []
    columnColorMode: none
    showEmpty: false
  - type: table
    name: All
    order:
      - formula.Name
      - formula.Responsibilities
      - formula.Current Projects
      - formula.Projects
      - formula.active
    sort: []
    columnSize:
      formula.Name: 130
      formula.Responsibilities: 283
      formula.Current Projects: 377
    rowHeight: medium
