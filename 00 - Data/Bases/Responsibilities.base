filters:
  or:
    - type.contains(link("Responsibilities"))
    - file.folder == "00 - Data/Responsibilities"
formulas:
  Name: file.asLink(if(name, name, file.name))
  Projects: file.backlinks.filter(value.asFile().properties.type.contains("Projects")).map(value.asFile().asLink(if(value.asFile().properties.name, value.asFile().properties.name, value.asFile().name)))
  Active Projects: formula.Projects.filter(value.asFile().properties.archive != true)
  active: if(!formula["Active Projects"].isEmpty(), "Active Projects", "Not Active Projects")
properties:
  formula.Active Projects:
    displayName: active projects
  formula.Projects:
    displayName: projects
views:
  - type: generic-kanban
    name: Active
    order:
      - formula.Name
      - missions
      - formula.Active Projects
    sort: []
    titleProperty: formula.Name
    columnSize:
      note.missions: 223
      formula.Active Projects: 572
      formula.Projects: 281
    rowHeight: medium
    columnProperty: formula.active
    columns:
      - Not Active Projects
      - Active Projects
    columnColors:
      - "Not Active Projects = #b40415"
      - "Active Projects = #039b0d"
    columnColorMode: header
    quickFilterProperties:
      - note.missions
    showEmpty: false
  - type: generic-kanban
    name: Related
    filters:
      and:
        - list(missions).contains(this)
    order:
      - formula.Name
      - missions
      - formula.Active Projects
    sort: []
    titleProperty: formula.Name
    columnSize:
      note.missions: 223
      formula.Active Projects: 572
      formula.Projects: 281
    rowHeight: medium
    columnProperty: formula.active
    columns:
      - Not Active Projects
      - Active Projects
    columnColors: []
    columnColorMode: none
    quickFilterProperties:
      - note.missions
    showEmpty: false
  - type: table
    name: All
    order:
      - formula.Name
      - missions
      - formula.Active Projects
      - formula.Projects
