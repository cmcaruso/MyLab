filters:
  and:
    - type.contains(link("People"))
    - file.folder == "00 - Data/People"
formulas:
  Name: file.asLink(if(name, name, file.name))
views:
  - type: cards
    name: Cards
    filters:
      and:
        - archive != true
    groupBy:
      property: org
      direction: ASC
    groupOrder:
      - - "[[ORG-0002|Greenvale University]]"
      - - "[[ORG-0003|St. Aurelian Hospital]]"
      - - "[[ORG-0005|Nordhaven University]]"
      - - "[[ORG-0004|Lumenbridge Diagnostics]]"
      - - "[[ORG-0001|UCBM]]"
    order:
      - formula.Name
    sort:
      - property: title
        direction: ASC
    image: note.image
    cardSize: 180
  - type: table
    name: Table
    filters:
      and:
        - archive != true
    order:
      - formula.Name
      - title
      - role
      - org
      - email
      - department
      - unit
      - orcID
    rowHeight: medium
  - type: table
    name: All
    order:
      - archive
      - formula.Name
      - title
      - role
      - org
      - email
      - department
      - unit
      - orcID
      - image
    sort:
      - property: name
        direction: ASC
    rowHeight: medium
  - type: cards
    name: Related People
    filters:
      and:
        - list(org).contains(this)
        - archive != true
    sort:
      - property: title
        direction: ASC
    image: note.image
