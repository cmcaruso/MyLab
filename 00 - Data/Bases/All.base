formulas:
  Name: file.asLink(if(name, name, file.name))
views:
  - type: table
    name: Recent
    filters:
      and:
        - file.mtime >= today()-"7d"
    order:
      - formula.Name
      - type
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
    columnSize:
      formula.Name: 162
  - type: table
    name: All
    order:
      - formula.Name
      - file.mtime
      - type
    sort:
      - property: file.mtime
        direction: DESC
