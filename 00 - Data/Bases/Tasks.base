filters:
  or:
    - type.contains(link("Tasks"))
    - file.folder == "00 - Data/Tasks"
formulas:
  Name: file.asLink(if(name, name, file.name))
  PriorityRank: if(priority == "Urgent", 0, if(priority == "High", 1, if(priority == "Medium", 2, if(priority == "Low", 3, 4))))
views:
  - type: generic-kanban
    name: Active
    filters:
      and:
        - archive != true
    order:
      - formula.Name
      - assignees
      - priority
      - scheduled
    sort:
      - property: formula.PriorityRank
        direction: ASC
      - property: scheduled
        direction: ASC
    columnProperty: note.status
    columns:
      - Backlog
      - Planning
      - In Progress
      - Done
    titleProperty: formula.Name
    columnColors:
      - "Planning = #00b3ff"
      - "In Progress = #fed401"
      - "Done = #06c650"
    columnColorMode: subtle
    showEmpty: false
    quickFilterProperties:
      - note.assignees
      - note.stories
  - type: generic-kanban
    name: By Priority
    filters:
      and:
        - archive != true
        - status != "Done"
    order:
      - formula.Name
      - status
      - assignees
      - scheduled
    sort:
      - property: scheduled
        direction: ASC
    columnProperty: note.priority
    columns:
      - Low
      - Medium
      - High
      - Urgent
    titleProperty: formula.Name
    columnColors:
      - "Low = #00b3ff"
      - "Medium = #fed401"
      - "High = #f76b15"
      - "Urgent = #e5484d"
    columnColorMode: subtle
    showEmpty: false
    quickFilterProperties:
      - note.assignees
      - note.stories
  - type: generic-kanban
    name: Current Sprint
    filters:
      and:
        - stories.filter(value.asFile().properties.sprints.filter(date(value.asFile().properties.start) <= today() && date(value.asFile().properties.end) >= today()).length > 0).length > 0
        - archive != true
    order:
      - formula.Name
      - priority
      - status
      - assignees
      - scheduled
    sort:
      - property: formula.PriorityRank
        direction: ASC
      - property: scheduled
        direction: ASC
    columnProperty: note.status
    columns:
      - Backlog
      - Planning
      - In Progress
      - Done
    titleProperty: formula.Name
    columnColors:
      - "Planning = #00b3ff"
      - "In Progress = #fed401"
      - "Done = #06c650"
    columnColorMode: subtle
    showEmpty: false
    quickFilterProperties:
      - note.assignees
      - note.stories
  - type: table
    name: All
    order:
      - formula.Name
      - priority
      - status
      - stories
    sort:
      - property: formula.PriorityRank
        direction: ASC
      - property: scheduled
        direction: ASC
    columnSize:
      formula.Name: 245
      note.stories: 472
    rowHeight: medium
  - type: generic-kanban
    name: Related
    filters:
      and:
        - list(stories).contains(this)
    order:
      - formula.Name
      - priority
      - status
      - assignees
      - scheduled
    sort:
      - property: formula.PriorityRank
        direction: ASC
      - property: scheduled
        direction: ASC
    columnProperty: note.status
    columns:
      - Backlog
      - Planning
      - In Progress
      - Done
    titleProperty: formula.Name
    columnColors:
      - "Planning = #00b3ff"
      - "In Progress = #fed401"
      - "Done = #06c650"
    columnColorMode: subtle
    showEmpty: false
    quickFilterProperties:
      - note.assignees
      - note.stories
