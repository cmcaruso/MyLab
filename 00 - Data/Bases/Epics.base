filters:
  and:
    - type.contains(link("Epics"))
formulas:
  stories: file.backlinks.filter(value.asFile().properties.type.contains("Stories"))
  status: if(formula.tasks.isEmpty(), "Backlog", if(formula.tasks.filter(value.asFile().properties.status == "Done").length == formula.tasks.length, "Done", if(formula.tasks.filter(value.asFile().properties.status == "Planning").length == formula.tasks.length, "Planning", if(formula.tasks.filter(value.asFile().properties.status == "Backlog").length == formula.tasks.length, "Backlog", "In Progress"))))
  tasks: formula.stories.map(value.asFile().backlinks.filter(value.asFile().properties.type.contains("Tasks"))).flat().unique()
views:
  - type: generic-kanban
    name: Active
    filters:
      and:
        - archive != true
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - projects
    cardSize: 200
    columnProperty: formula.status
    columns:
      - Backlog
      - Planning
      - In Progress
      - Done
    columnColors:
      - "Planning = #00b3ff"
      - "In Progress = #fed401"
      - "Done = #06c650"
    columnColorMode: subtle
    showEmpty: false
    quickFilterProperties:
      - note.projects
  - type: generic-kanban
    name: Related
    filters:
      and:
        - list(projects).contains(this)
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - projects
    cardSize: 200
    columnProperty: formula.status
    columns:
      - Backlog
      - Planning
      - In Progress
      - Done
    columnColors:
      - "Planning = #00b3ff"
      - "In Progress = #fed401"
      - "Done = #06c650"
    columnColorMode: subtle
    showEmpty: false
  - type: table
    name: All
    order:
      - archive
      - file.name
      - projects
      - formula.status
      - formula.stories
      - formula.tasks
    sort: []
    columnSize:
      formula.tasks: 280
