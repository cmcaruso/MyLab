filters:
  and:
    - type.contains(link("Projects"))
views:
  - type: generic-kanban
    name: Active
    filters:
      and:
        - archive != true
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - org
      - activities
      - tags
    markers: bullet
    cardSize: 220
    columnProperty: note.status
    columns:
      - Backlog
      - Proposal
      - Ongoing
      - Closed
    columnColors:
      - "Proposal = #00b3ff"
      - "Ongoing = #fed401"
      - "Closed = #06c650"
    columnColorMode: subtle
    showEmpty: false
    quickFilterProperties:
      - note.activities
  - type: generic-kanban
    name: Related
    filters:
      and:
        - list(activities).contains(this)
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - org
      - activities
      - tags
    markers: bullet
    cardSize: 220
    columnProperty: note.status
    columns:
      - Backlog
      - Proposal
      - Ongoing
      - Closed
    columnColors:
      - "Proposal = #00b3ff"
      - "Ongoing = #fed401"
      - "Closed = #06c650"
    columnColorMode: subtle
    showEmpty: false
    quickFilterProperties:
      - note.activities
  - type: table
    name: All
    order:
      - archive
      - file.name
      - categories
      - status
      - org
      - tags
    sort: []
