filters:
  or:
    - type.contains(link("Projects"))
    - file.folder == "00 - Data/Projects"
formulas:
  Name: file.asLink(if(name, name, file.name))
  PriorityRank: if(priority == "Urgent", 0, if(priority == "High", 1, if(priority == "Medium", 2, if(priority == "Low", 3, 4))))
views:
  - type: generic-kanban
    name: Active
    filters:
      and:
        - archive != true
    groupBy:
      property: status
      direction: ASC
    order:
      - formula.Name
      - priority
      - org
      - activities
      - tags
    titleProperty: formula.Name
    markers: bullet
    cardSize: 220
    columnProperty: note.status
    columns:
      - Backlog
      - Proposal
      - Ongoing
      - Funded
      - Under Review
      - Closed
    columnColors:
      - "Proposal = #00b3ff"
      - "Ongoing = #fed401"
      - "Funded = #d17a00"
      - "Under Review = #7e00c2"
      - "Closed = #06c650"
    columnColorMode: subtle
    showEmpty: false
    quickFilterProperties:
      - note.activities
    sort:
      - property: formula.PriorityRank
        direction: ASC
  - type: generic-kanban
    name: Related
    filters:
      and:
        - list(activities).contains(this)
    groupBy:
      property: status
      direction: ASC
    order:
      - formula.Name
      - priority
      - org
      - activities
      - tags
    titleProperty: formula.Name
    markers: bullet
    cardSize: 220
    columnProperty: note.status
    columns:
      - Backlog
      - Proposal
      - Ongoing
      - Closed
    columnColors:
      - "Proposal = #00b3ff"
      - "Ongoing = #fed401"
      - "Closed = #06c650"
    columnColorMode: subtle
    showEmpty: false
    quickFilterProperties:
      - note.activities
    sort:
      - property: formula.PriorityRank
        direction: ASC
  - type: table
    name: All
    order:
      - archive
      - formula.Name
      - priority
      - categories
      - status
      - org
      - tags
    sort:
      - property: formula.PriorityRank
        direction: ASC
