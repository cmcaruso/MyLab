filters:
  or:
    - type.contains(link("Sprints"))
    - file.folder == "00 - Data/Sprints"
formulas:
  Name: file.asLink(if(name, name, file.name))
views:
  - type: table
    name: Table
    order:
      - formula.Name
      - start
      - end
    sort:
      - property: start
        direction: DESC
    columnSize:
      formula.Name: 183
