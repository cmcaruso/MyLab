filters:
  or:
    - type.contains(link("Session Transcripts"))
    - file.folder == "99 - Agents/agents/transcripts"
formulas:
  Name: file.asLink(if(name, name, file.name))
views:
  - type: table
    name: All
    order:
      - formula.Name
      - session
      - agent
      - model
      - start
      - end
    sort:
      - property: start
        direction: DESC
  - type: table
    name: Related
    filters:
      and:
        - session == this
    order:
      - formula.Name
      - agent
      - model
      - start
    sort:
      - property: start
        direction: DESC
