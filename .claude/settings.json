{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "plansDirectory": "00 - Data/Plans",
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit(/00 - Data/Daily Notes/**)",
      "Edit(/00 - Data/Notes/**)",
      "Edit(/00 - Data/Meetings/**)",
      "Edit(/00 - Data/Tasks/**)",
      "Edit(/00 - Data/Stories/**)",
      "Edit(/00 - Data/Issues/**)",
      "Edit(/00 - Data/Sprints/**)",
      "Edit(/00 - Data/References/**)",
      "Edit(/00 - Data/Sessions/**)",
      "Edit(/00 - Data/Plans/**)",
      "Edit(/99 - Agents/agents/examples/**)",
      "Edit(/99 - Agents/agents/memory/**)",
      "Bash(python3 \"99 - Agents/agents/scripts/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(ls*)",
      "Bash(wc *)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(unlink *)",
      "Bash(trash *)",
      "Bash(mv *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(find * -delete*)",
      "Bash(find * -exec*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(ssh *)",
      "WebFetch",
      "WebSearch",
      "Artifact",
      "ArtifactData",
      "ArtifactComments",
      "RemoteTrigger",
      "CronCreate"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git stash*)",
      "Bash(git rebase*)",
      "Bash(git branch -D*)",
      "Bash(git filter-branch*)",
      "Edit(/.git/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/99 - Agents/claude/hooks/guard-edits.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/99 - Agents/claude/hooks/session-stub.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
